SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*
# Only read when DEBUG=False — comma-separated list of allowed frontend origins,
# e.g. https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Leave blank for local dev (falls back to sqlite). On Render, set this to the
# Internal Database URL of your Postgres instance, e.g.
# postgresql://user:password@host/dbname
DATABASE_URL=

# Leave EMAIL_HOST_USER blank to print emails to the console/log instead of
# trying (and failing) to send real SMTP mail.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@novulab.com
